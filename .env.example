# ---- Frontend (public, safe to commit; already in .env) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ---- Server (secret: put these in .env.local and in Vercel project settings) ----
OPENAI_API_KEY=sk-...
# Optional
OPENAI_MODEL=gpt-5.4-mini
AI_RATE_LIMIT_PER_10_MIN=20
# Comma-separated extra origins allowed by CORS (the deployed site itself needs no entry)
ALLOWED_ORIGINS=
# On Vercel, also set these (the server reads the same values the frontend uses):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
